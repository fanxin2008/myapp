<!--index.wxml-->
<view class="page" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav">
    <text class="nav-title">刹车挑战大师</text>
    <view class="nav-row">
      <view class="rank-btn" bindtap="goRank">
        <view class="rank-icon">
          <view class="rank-bar"></view>
          <view class="rank-bar"></view>
          <view class="rank-bar"></view>
        </view>
        <text>排行榜</text>
      </view>
    </view>
  </view>

  <view class="hero">
    <text class="hero-title">挑战最快刹停</text>
    <text class="hero-sub">车辆持续加速 · 超速即失败</text>
  </view>

  <view class="gauge">
    <view class="gauge-arc-wrap">
      <view class="gauge-arc"></view>
    </view>
    <text class="tick tick-0">0</text>
    <text class="tick tick-50">50</text>
    <text class="tick tick-100">100</text>
    <text class="tick tick-150">150</text>
    <text class="tick tick-200">200</text>
    <view class="gauge-needle" style="transform: rotate({{needleAngle}}deg);"></view>
    <view class="gauge-center">
      <text class="gauge-speed">{{speed}}</text>
      <text class="gauge-unit">{{unit}}</text>
    </view>
  </view>

  <view class="metrics">
    <view class="metric">
      <text class="metric-label">反应时间</text>
      <text class="metric-value">{{reactionTime}}</text>
    </view>
    <view class="metric">
      <text class="metric-label">总用时</text>
      <text class="metric-value">{{totalTime}}</text>
    </view>
    <view class="metric">
      <text class="metric-label">制动距离</text>
      <text class="metric-value">{{brakeDistance}}</text>
    </view>
  </view>

  <view class="bottom">
    <view class="force-card">
      <view class="force-bar"></view>
      <view class="force-body">
        <text class="force-label">刹车力度</text>
        <text class="force-value">{{brakeForce}}</text>
      </view>
      <view class="force-status {{brakeOn ? 'on' : ''}}">
        <view class="status-dot"></view>
        <text>ON</text>
      </view>
    </view>

    <view class="start-wrap">
      <view class="start-btn {{isPressing ? 'pressing' : ''}}" bindtouchstart="startBrake" bindtouchend="stopBrake" bindtouchcancel="stopBrake">
        <text class="btn-txt">{{buttonText}}</text>
        <text class="remain">剩余{{remainCount}}次</text>
      </view>
    </view>
  </view>

  <text class="footer-tip">超过 1600N 会断裂</text>

  <view class="result-mask" wx:if="{{resultVisible}}" bindtap="closeResult" catchtouchmove="noop">
    <view class="result-card" catchtap="noop">
      <view class="result-title">{{result.title}}</view>
      <view class="result-desc" wx:if="{{result.desc}}">{{result.desc}}</view>

      <view class="result-hero" wx:if="{{result.bigValue}}">
        <text class="result-big">{{result.bigValue}}</text>
        <text class="result-big-label">{{result.bigLabel}}</text>
      </view>

      <view class="result-stats" wx:if="{{result.stats && result.stats.length}}">
        <view class="result-stat" wx:for="{{result.stats}}" wx:key="label">
          <text class="result-stat-label">{{item.label}}</text>
          <text class="result-stat-value">{{item.value}}</text>
        </view>
      </view>

      <block wx:if="{{result.type === 'success'}}">
        <view class="best-row">
          <text class="best-label">个人最好纪录</text>
          <text class="best-value">{{result.bestRecordText}}</text>
        </view>

        <view class="ranking-row" wx:if="{{result.rankingText}}">
          <text class="ranking-text">{{result.rankingText}}</text>
        </view>

        <view class="saving-row" wx:if="{{result.saving}}">
          <text class="saving-text">成绩保存中…</text>
        </view>

        <block wx:if="{{result.canPublish}}">
          <view class="nick-row">
            <text class="nick-label">车手昵称</text>
            <input class="nick-input" maxlength="16" placeholder="（1-16字）" value="{{nickname}}" bindinput="onNicknameInput" />
          </view>
          <text class="nick-error" wx:if="{{nicknameError}}">{{nicknameError}}</text>
          <view class="ip-row">
            <text class="ip-label">IP 属地：{{ipLocation}}</text>
          </view>
          <view class="submit-btn {{result.submitted ? 'submitted' : ''}}" bindtap="submitRecord">{{result.submitted ? '已提交' : '提交个人新纪录'}}</view>
          <text class="submit-tip">提交即公开昵称、最好成绩和 IP 属地，每人保留一条纪录。属地自动识别，不获取 GPS.</text>
        </block>

        <text class="success-tip" wx:if="{{result.firstRecordTip}}">首次成功刹停！填写昵称，留下你的个人纪录。</text>
      </block>

      <view class="result-actions">
        <view class="action-btn ghost" bindtap="goHome">返回首页</view>
        <view class="action-btn primary" wx:if="{{result.type !== 'exhausted'}}" bindtap="retry">
          <text class="action-main">再试一次</text>
          <text class="action-sub">剩余{{remainCount}}次</text>
        </view>
      </view>
    </view>
  </view>
</view>
