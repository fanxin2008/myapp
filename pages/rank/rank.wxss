.page {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 36rpx;
  background: #0e1024;
  color: #edeeeb;
}

.nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 20rpx;
}

.back {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8ea7ff;
  font-size: 48rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
}

.tabs {
  display: flex;
  margin-top: 20rpx;
  border-bottom: 1rpx solid rgba(139, 124, 246, 0.18);
}

.tab {
  position: relative;
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  color: #8b93a1;
  font-size: 28rpx;
}

.tab.active {
  color: #edeeeb;
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #7fb2ff, #8b5cf6);
}

.head,
.row {
  display: flex;
  align-items: center;
}

.head {
  padding: 28rpx 0 18rpx;
  color: #8b93a1;
  font-size: 22rpx;
}

.row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(139, 124, 246, 0.10);
}

.row .rank {
  color: #8b93a1;
}

.row .name {
  color: #edeeeb;
}

.row .city {
  color: #8b93a1;
}

.row .time {
  color: #7fb2ff;
  font-weight: 700;
}

.col.rank {
  width: 120rpx;
}

.col.name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col.city {
  width: 180rpx;
  text-align: center;
}

.col.time {
  width: 180rpx;
  text-align: right;
}

.footer {
  margin-top: auto;
  padding: 32rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  color: #5d6673;
  font-size: 22rpx;
}

.footer .my-rank {
  display: block;
  margin-bottom: 10rpx;
  color: #7fb2ff;
  font-size: 24rpx;
  font-weight: 700;
}

.footer .count {
  display: block;
}

.footer .more {
  display: block;
  margin-top: 8rpx;
  color: #4d5664;
  font-size: 20rpx;
}

.empty,
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #5d6673;
  font-size: 24rpx;
}
