<view class="page">
  <view class="nav">
    <text class="nav-title">排行榜</text>
  </view>

  <view class="tabs">
    <view class="tab {{scope === 'nation' ? 'active' : ''}}" bindtap="switchScope" data-scope="nation">全国</view>
    <view class="tab {{scope === 'province' ? 'active' : ''}}" bindtap="switchScope" data-scope="province">全省</view>
    <view class="tab {{scope === 'city' ? 'active' : ''}}" bindtap="switchScope" data-scope="city">全市</view>
  </view>

  <view class="head">
    <text class="col rank">名次</text>
    <text class="col name">玩家</text>
    <text class="col city">城市</text>
    <text class="col time">用时</text>
  </view>

  <view class="list">
    <view class="row" wx:for="{{list}}" wx:key="userId">
      <text class="col rank">{{item.rank}}</text>
      <text class="col name">{{item.nickname}}</text>
      <text class="col city">{{item.cityName}}</text>
      <text class="col time">{{item.timeText}}</text>
    </view>

    <view class="empty" wx:if="{{!loading && !list.length}}">暂无数据</view>
    <view class="loading" wx:if="{{loading}}">加载中…</view>
  </view>

  <view class="footer">
    <text class="my-rank" wx:if="{{myRankText}}">{{myRankText}}</text>
    <text class="count">{{scopeText}} · {{count}}人</text>
    <text class="more">{{hasMore ? '上拉加载更多' : '已经到底啦'}}</text>
  </view>
</view>
